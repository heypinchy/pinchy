# ─────────────────────────────────────────────────────────────
# Required
PINCHY_VERSION=v0.9.1

# ─────────────────────────────────────────────────────────────
# Database password — set this for production.
# Generate with: openssl rand -hex 32
# (If unset, Docker Compose uses 'pinchy_dev' — fine for local dev,
#  Pinchy logs a warning when NODE_ENV=production detects it.)
# DB_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Optional overrides — Pinchy auto-generates these on first boot
# and persists them to the pinchy-secrets Docker volume.
# Set these only if you want explicit control for backup / rotation.
# Generate with: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Optional
# PINCHY_PORT=0.0.0.0:7777   # default: 127.0.0.1:7777
# PINCHY_ENTERPRISE_KEY=
# PINCHY_ADMIN_EMAIL=admin@example.com
# PINCHY_ADMIN_PASSWORD=change-me
# PINCHY_TRUSTED_PROXIES=10.0.0.0/8,173.245.48.0/20   # extra proxy hops in front of your own
