{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx drizzle-kit *)",
      "Bash(docker compose *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(pnpm test *)",
      "Bash(pnpm install *)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/require-docs-review.mjs",
            "if": "Bash(gh pr create*)",
            "statusMessage": "Checking the docs have been read"
          }
        ]
      }
    ]
  }
}
