# Pull node:22-slim via Google's Docker Hub mirror to avoid Docker Hub
# anonymous-pull rate limits in CI. mirror.gcr.io is a free, no-auth
# pull-through cache for `library/*` images on Docker Hub.
FROM mirror.gcr.io/library/node:22-slim

RUN corepack enable

# Same LibreOffice toolchain as the production image (see Dockerfile.pinchy for
# why these exact packages). Dev needs it too: the dev stack's office-converter
# service runs THIS image, and without it every Office document would report
# "converter did not run", which looks nothing like production.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-writer libreoffice-impress libreoffice-calc fonts-liberation catdoc \
    && rm -rf /var/lib/apt/lists/*

# No compiler toolchain: better-sqlite3 >= 13 ships N-API prebuilds inside the
# package, so the install compiles nothing (see Dockerfile.pinchy and
# agent-rules/dependencies.md § "A Documented Fallback That Cannot Run Is Not A
# Fallback").

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/web/package.json packages/web/
# pnpm applies pnpm.patchedDependencies during install — the patch files must be
# present in the build context before `pnpm install` (see Dockerfile.pinchy).
COPY patches/ ./patches/

RUN pnpm install --frozen-lockfile

# Source files are bind-mounted over this in docker-compose.dev.yml,
# but copying them here ensures the image also works standalone.
COPY packages/web packages/web

RUN mkdir -p /app/secrets /var/spool/pinchy-office

# Office conversion goes to the office-converter sidecar, exactly as in
# production (see Dockerfile.pinchy) — the dev stack must not quietly convert
# in-process, where the production boundary does not exist.
ENV KB_OFFICE_SPOOL_DIR=/var/spool/pinchy-office

EXPOSE 7777

ENV PORT=7777

WORKDIR /app/packages/web

CMD ["sh", "-c", "rm -rf .next/* .next/.* 2>/dev/null; pnpm db:migrate && pnpm dev"]
