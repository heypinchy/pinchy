# Pull node:22-slim via Google's Docker Hub mirror to avoid Docker Hub
# anonymous-pull rate limits in CI. mirror.gcr.io is a free, no-auth
# pull-through cache for `library/*` images on Docker Hub.
FROM mirror.gcr.io/library/node:22-slim

RUN corepack enable

# Same LibreOffice toolchain as the production image (see Dockerfile.pinchy for
# why these exact packages). Dev needs it too: without it, indexing an Office
# document in the dev stack reports every file as "converter did not run"
# infrastructure failures, which looks nothing like the production behaviour it
# is supposed to reproduce.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-writer libreoffice-impress fonts-liberation catdoc \
    && rm -rf /var/lib/apt/lists/*

# python3 + build-essential make better-sqlite3's DOCUMENTED fallback real.
# Its install script is `prebuild-install || node-gyp rebuild --release`: the
# first half downloads a prebuilt binary, the second compiles one when that
# download is unusable. Without a toolchain the second half cannot run, so a
# transient network hiccup — `prebuild-install warn install Request timed out`,
# observed in CI on 2026-08-05 — is not a slower build, it is a HARD build
# failure that a rerun only heals for as long as the next download happens to
# succeed. Dockerfile.openclaw has carried this pair since its split for the
# same module; the two pinchy images never did (CI run 30994369292 on PR #1110).
#
# It costs 306 MB in this single-stage dev image, measured (`docker history`),
# next to LibreOffice's 423 MB. Dockerfile.pinchy pays nothing at runtime — see
# its `base` stage. That is the price of the fallback existing at all, and a
# dev image is the right place to pay it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/web/package.json packages/web/
# pnpm applies pnpm.patchedDependencies during install — the patch files must be
# present in the build context before `pnpm install` (see Dockerfile.pinchy).
COPY patches/ ./patches/

RUN pnpm install --frozen-lockfile

# Source files are bind-mounted over this in docker-compose.dev.yml,
# but copying them here ensures the image also works standalone.
COPY packages/web packages/web

RUN mkdir -p /app/secrets

EXPOSE 7777

ENV PORT=7777

WORKDIR /app/packages/web

CMD ["sh", "-c", "rm -rf .next/* .next/.* 2>/dev/null; pnpm db:migrate && pnpm dev"]
