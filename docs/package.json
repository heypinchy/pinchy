{
  "name": "pinchy-docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "sh scripts/inject-version.sh && astro dev; sh scripts/restore-placeholders.sh",
    "build": "sh scripts/inject-version.sh && sh scripts/with-restore.sh sh -c 'astro build && node scripts/generate-llms-txt.mjs'",
    "preview": "astro preview",
    "check:tables": "node scripts/check-no-tables-in-lists.mjs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:rendered": "node scripts/check-rendered-tables.mjs",
    "check:llms": "node scripts/check-llms-txt.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.3",
    "@pasqal-io/starlight-client-mermaid": "^0.1.0",
    "astro": "^6.4.8",
    "astro-loader-github-releases": "^3.0.1",
    "mermaid": "^11.16.1"
  },
  "pnpm": {
    "overrides": {
      "defu@<=6.1.4": "^6.1.5",
      "devalue@<5.9.2": "^5.9.2",
      "esbuild@<0.28.1": ">=0.28.1",
      "dompurify@<3.4.16": "^3.4.16",
      "h3@>=1.15.0 <1.15.9": "^1.15.9",
      "lodash-es@<4.18.0": "^4.18.0",
      "picomatch@<2.3.2": "~2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "smol-toml@<1.9.0": "^1.9.0",
      "uuid@<14.0.0": ">=14.0.0",
      "vite@>=7.0.0 <7.3.5": "^7.3.5",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "postcss@<8.5.23": ">=8.5.23",
      "svgo@<4.1.0": "^4.1.0",
      "sharp@<0.35.5": ">=0.35.5 <0.36",
      "postcss-selector-parser@<7.1.6": ">=7.1.6 <8",
      "nanoid@>=3.0.0 <3.3.17": ">=3.3.17 <4",
      "source-map-js@<1.2.2": ">=1.2.2 <2",
      "http-cache-semantics@<4.3.0": ">=4.3.0 <5",
      "mermaid>katex": ">=0.18.2 <0.19"
    }
  }
}
